<?xml version="1.0"?>
<robot name="ffw_f2_follower">
  <!--Calculation model: measured lift + 14 arm DOFs; head collision fixed at neutral, as in BG2/SG2.-->
  <!--No hardware or finger DOFs.-->
  <link name="base_link">
    <collision>
      <origin rpy="0 0 0" xyz="-0.15 0 0.2" />
      <geometry>
        <box size="0.6 0.4 0.3" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 1.57 0" xyz="-0.15 0.2 0.2" />
      <geometry>
        <cylinder length="0.6" radius="0.15" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 1.57 0" xyz="-0.15 -0.2 0.2" />
      <geometry>
        <cylinder length="0.6" radius="0.15" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="1.57 1.57 0" xyz="0.15 0 0.2" />
      <geometry>
        <cylinder length="0.4" radius="0.15" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0.15 0.2 0.2" />
      <geometry>
        <sphere radius="0.15" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0.15 -0.2 0.2" />
      <geometry>
        <sphere radius="0.15" />
      </geometry>
    </collision>
  </link>
  <link name="arm_base_link">
    <!--BG2/SG2 body proxies shifted to the F-series shoulder mount center and spacing.-->
    <collision>
      <origin rpy="0 0.1 0" xyz="0.027 0 -0.17" />
      <geometry>
        <box size="0.2 0.2164 0.63" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0.1 0" xyz="0.07675 0.1082 -0.175" />
      <geometry>
        <cylinder length="0.63" radius="0.05" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0.1 0" xyz="-0.02275 0.1082 -0.165" />
      <geometry>
        <box size="0.2 0.1 0.63" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0.1 0" xyz="0.07675 -0.1082 -0.175" />
      <geometry>
        <cylinder length="0.63" radius="0.05" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0.1 0" xyz="-0.02275 -0.1082 -0.165" />
      <geometry>
        <box size="0.2 0.1 0.63" />
      </geometry>
    </collision>
  </link>
  <!--F-series head mounting transforms; retain the BG2/SG2 head collision sphere.-->
  <joint name="head_joint1" type="fixed">
    <parent link="arm_base_link" />
    <child link="head_link1" />
    <origin rpy="0 0 0" xyz="0.102729 0 0.132803" />
  </joint>
  <link name="head_link1" />
  <joint name="head_joint2" type="fixed">
    <parent link="head_link1" />
    <child link="head_link2" />
    <origin rpy="0 0 0" xyz="0.0141410 0 0.0555070" />
  </joint>
  <link name="head_link2">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.02" />
      <geometry>
        <sphere radius="0.1" />
      </geometry>
    </collision>
  </link>
  <link name="arm_l_link1">
  </link>
  <link name="arm_l_link2">
    <!--BG2/SG2 capsule: axial span 0.3000 -> 0.3200 m; keep radii and end padding.-->
    <collision>
      <origin rpy="0 1.5708 0" xyz="0 0 0" />
      <geometry>
        <sphere radius="0.07" />
      </geometry>
    </collision>
